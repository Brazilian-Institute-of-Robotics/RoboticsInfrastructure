<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="hokuyo_alter">
    <pose>0 0 0.035 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.1</mass>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://hokuyo_alter/meshes/hokuyo.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision-base">
        <pose>0 0 -0.0145 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.041</size>
          </box>
        </geometry>
      </collision>

      <collision name="collision-top">
        <pose>0 0 0.0205 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.021</radius>
            <length>0.029</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="laser" type="ray">
        <pose>0.01 0 0.0175 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.57000</min_angle>
              <max_angle>1.57000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <plugin name="hokuyo_ros_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=my_robot/laser/scan</remapping>
          </ros>
          <topic>scan</topic>
          <frame_name>link</frame_name>
          <output_type>sensor_msgs/LaserScan</output_type>
          <update_rate>30</update_rate>
        </plugin>

        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
